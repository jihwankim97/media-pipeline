{
    "jsc": {
      "parser": {
        "syntax": "typescript",
        "tsx": false,
        "decorators": true,
        "dynamicImport": true
      },
      "transform": {
        "decoratorMetadata": true,
        "legacyDecorator": true
      },
      "target": "es2018"
    },
    "module": {
      "type": "commonjs"
    }
  }